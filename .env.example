# Supabase (required for tickets, orders, votes, admin, VRChat world link)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON=your-anon-public-key-here

# Stripe publishable key (for future or ticket components if using)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# App URL override for success/cancel redirects in Stripe (useful for preview flows).
# When previewing via a custom domain like www.trapaganza.com that may have incomplete SSL cert
# provisioning in the preview service, set this to the safe orchids.cloud preview URL instead.
# Example:
# VITE_APP_URL=https://5173-xxxxx.orchids.cloud
VITE_APP_URL=

# Note: The real .env contains the actual production keys for Trap Street Radio Supabase project.